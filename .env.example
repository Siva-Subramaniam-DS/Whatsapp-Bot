# Long random secret used to sign licence keys. Keep it private.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_SECRET=change-me

# Where WhatsApp login data and the database are stored
AUTH_DIR=./auth
DB_PATH=./data/scamguard.db

# Your phone number's country code. Senders from other countries get a small risk bump.
HOME_COUNTRY_CODE=44

# Link shown in the Free plan's "scam removed" message
PROMO_LINK=https://example.com/scamguard

# Phone numbers (digits only, comma separated) that can run owner-only commands
OWNER_NUMBERS=
